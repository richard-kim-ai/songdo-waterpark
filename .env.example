# Supabase — Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 서버 전용 (예약 생성 등 쓰기 작업 / RLS 우회가 필요한 경우에만 사용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 케노피 예약 알림 메일 (Gmail 앱 비밀번호 방식)
# 발신 계정: Google 계정에서 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 앱 비밀번호(16자) 발급
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 알림을 받을 주소 (생략 시 GMAIL_USER로 발송)
NOTIFY_EMAIL=your-gmail@gmail.com
